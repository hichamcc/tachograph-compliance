APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_STACK=single

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAPON_API_KEY=replace_with_local_api_key
MAPON_BASE_URL=https://mapon.com/api/v1/
MAPON_TIMEOUT=60
MAPON_AUTH_MODE=header
MAPON_AUTH_HEADER=key

TACHO_TIMEZONE_DISPLAY=Europe/Copenhagen
TACHO_WEEK_TIMEZONE=UTC
TACHO_SHOW_TIMELINE=false  # day-by-day activity chart on reports
TACHO_RAW_RETENTION_DAYS=90
TACHO_ACTIVE_WEEKS=5
TACHO_CRON_TOKEN=            # php -r "echo bin2hex(random_bytes(24));"  (empty = cron URL disabled)
TACHO_CRON_SECONDS=25
TACHO_ALLOW_IMPORT=false   # true only for local testing (JSON upload form)
